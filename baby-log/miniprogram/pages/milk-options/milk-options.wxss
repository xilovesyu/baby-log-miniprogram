.tip { background: var(--primary-light); }
.link { color: var(--primary); font-size: 26rpx; }
.mo-chip { display: inline-flex; align-items: center; margin: 6rpx; padding: 12rpx 10rpx 12rpx 24rpx; border-radius: 30rpx; background: #F1F3F6; font-size: 28rpx; }
.mo-x { margin-left: 12rpx; color: var(--text-sub); padding: 0 8rpx; }
.add-input { border: 1rpx solid var(--line); border-radius: 12rpx; padding: 16rpx 20rpx; width: 220rpx; }
.unit-suffix { margin: 0 20rpx; color: var(--text-sub); }
.add-btn { background: var(--primary); color: #fff; }
.mr8 { margin-right: 16rpx; }
