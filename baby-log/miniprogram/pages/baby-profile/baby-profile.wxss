.unit-switch { width: 96rpx; text-align: center; padding: 8rpx 0; border: 1rpx solid var(--line); border-radius: 12rpx; color: var(--primary); background: var(--primary-light); }
.avatar-row { display: flex; align-items: center; padding-bottom: 20rpx; margin-bottom: 8rpx; border-bottom: 1rpx solid var(--line); }
.avatar-img { width: 120rpx; height: 120rpx; border-radius: 50%; margin-right: 24rpx; background: #F1F3F6; }
.avatar-ph { width: 120rpx; height: 120rpx; border-radius: 50%; margin-right: 24rpx; background: #F1F3F6; color: var(--text-sub); font-size: 48rpx; display: flex; align-items: center; justify-content: center; }
