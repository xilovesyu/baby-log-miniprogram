<view class="page">
  <view class="card profile" bindtap="editProfile">
    <image wx:if="{{avatarUrl}}" class="avatar avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar">{{currentInitial}}</view>
    <view class="col grow">
      <text class="pname">{{current.name || '未命名宝宝'}}</text>
      <text class="muted small">{{ageText}} · 出生 {{current.birthDate}}</text>
    </view>
    <text class="muted">编辑 ›</text>
  </view>

  <view wx:if="{{babies.length > 1}}" class="card">
    <view class="card-title">切换宝宝</view>
    <view class="baby-list">
      <view wx:for="{{babies}}" wx:key="_id" class="bitem {{item._id===current._id?'on':''}}" data-id="{{item._id}}" bindtap="switchBaby">{{item.name || '未命名'}}</view>
    </view>
  </view>

  <view class="card">
    <view class="menu-row" bindtap="editProfile"><text>宝宝档案</text><text class="muted">›</text></view>
    <view class="menu-row" bindtap="goMilkOptions"><text>奶量档位</text><text class="muted">›</text></view>
    <view class="menu-row" bindtap="goFamily"><text>共同照护者 / 只读分享</text><text class="muted">›</text></view>
    <view class="menu-row" bindtap="doImport"><text>导入 Excel 记录</text><text class="muted small">从微信选择表格</text></view>
    <view class="menu-row" bindtap="createShare"><text>只读分享给家人/医生</text><text class="muted">›</text></view>
    <view class="menu-row" bindtap="exportData"><text>数据导出</text><text class="muted small">导出为表格文件</text></view>
    <view class="menu-row" bindtap="createNew"><text>新建宝宝</text><text class="muted">›</text></view>
  </view>

  <view class="card">
    <view class="menu-row danger" bindtap="delBaby"><text>删除该宝宝及全部记录</text></view>
    <view class="muted small mt8">删除会一并清除其吃奶/辅食/便便/睡眠/健康记录，操作不可恢复。</view>
  </view>

  <view wx:if="{{!cloudReady}}" class="muted small center mt16">未配置云环境 ID，部分操作不可用（见 cloud.js）。</view>
</view>
