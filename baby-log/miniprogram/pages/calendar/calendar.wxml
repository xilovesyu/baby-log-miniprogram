<view class="page">
  <view class="card">
    <view class="row-between">
      <view class="nav-btn" bindtap="prevMonth">‹</view>
      <view class="month-label">{{monthLabel}}</view>
      <view class="nav-btn" bindtap="nextMonth">›</view>
    </view>
    <view class="row-between mt8">
      <text class="muted small">本月总奶量 {{monthTotal}}ml</text>
      <text class="muted small">本月日均 {{avgDaily}}ml</text>
    </view>

    <view class="weekhead">
      <text wx:for="{{weeks}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="grid7">
      <view wx:for="{{cells}}" wx:key="key" class="dcell {{item.blank?'blank':''}} {{item.selected?'sel':''}} {{item.isFuture?'future':''}}"
            data-date="{{item.date}}" bindtap="openDay">
        <view class="dnum">{{item.day}}</view>
        <view class="dmilk">{{item.blank ? '' : (item.recorded ? item.total + 'ml' : (item.isFuture ? '' : '未记录'))}}</view>
        <view class="dots">
          <text wx:if="{{item.hasSolid}}" class="dot solid"></text>
          <text wx:if="{{item.hasTemp}}" class="dot temp"></text>
          <text wx:if="{{item.hasWeight}}" class="dot weight"></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 当日抽屉 -->
  <view wx:if="{{selectedDate}}" class="mask" bindtap="closeDay"></view>
  <view wx:if="{{selectedDate}}" class="drawer">
    <view class="row-between">
      <view class="card-title" style="margin:0">{{selectedDate}} 详情</view>
      <text class="muted" bindtap="closeDay">✕</text>
    </view>
    <view class="small muted mt8">日总 {{selectedSummary.totalMilkMl}}ml · {{selectedSummary.feedCount}}次 · 平均 {{selectedSummary.avgPerFeed}}ml</view>
    <view wx:if="{{!selectedEvents.length}}" class="empty">这天没有记录</view>
    <scroll-view scroll-y class="drawer-body">
      <view class="tl-item" wx:for="{{selectedEvents}}" wx:key="id" data-item="{{item}}" bindtap="editEvent">
        <view class="tl-time">{{item.noTime ? '未记' : item.time}}</view>
        <view class="tl-dot {{item.type}}"><i></i></view>
        <view class="tl-body"><view class="tl-main">{{item.main}}</view>
          <view wx:if="{{item.note}}" class="tl-note">{{item.note}}</view></view>
      </view>
    </scroll-view>
    <view class="btn block mt16" bindtap="addOnDay">补录一条</view>
  </view>
</view>
