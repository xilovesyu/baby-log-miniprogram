.weekhead { display: flex; margin-top: 16rpx; }
.weekhead text { flex: 1; text-align: center; color: var(--text-sub); font-size: 24rpx; }
.nav-btn { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center; font-size: 40rpx; color: var(--primary); }
.month-label { font-size: 34rpx; font-weight: 700; }
.grid7 { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.dcell { width: 14.285%; height: 116rpx; box-sizing: border-box; padding: 6rpx 2rpx; text-align: center; position: relative; border-radius: 12rpx; }
.dcell.sel { background: var(--primary-light); }
.dcell.future { opacity: .4; }
.dnum { font-size: 30rpx; font-weight: 600; }
.dmilk { font-size: 18rpx; color: var(--text-sub); height: 26rpx; }
.dots { height: 16rpx; }
.dot { display: inline-block; width: 8rpx; height: 8rpx; border-radius: 50%; margin: 0 2rpx; }
.dot.solid { background: var(--food); } .dot.temp { background: #E8A0A0; } .dot.weight { background: #7C9CE0; }

.mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 10; }
.drawer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 28rpx 28rpx 40rpx; z-index: 11; max-height: 80vh; }
.drawer-body { max-height: 50vh; margin-top: 8rpx; }
