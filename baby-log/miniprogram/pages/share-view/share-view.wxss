.code { border: 1rpx solid var(--line); border-radius: 12rpx; padding: 20rpx; text-align: center; letter-spacing: 4rpx; }
.watermark { text-align: center; color: var(--text-sub); font-size: 24rpx; padding: 12rpx 0 20rpx; }
.mrow { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); font-size: 26rpx; }
.mrow.head { color: var(--text-sub); font-size: 24rpx; }
.mrow:last-child { border-bottom: none; }
