<view class="page">
  <!-- 共同照护者 -->
  <view class="card">
    <view class="row-between">
      <view class="card-title" style="margin:0">共同照护者</view>
      <text class="link" bindtap="genInvite">+ 生成邀请码</text>
    </view>
    <view class="mrow head"><text>成员</text><text>权限</text><text wx:if="{{canManage}}">操作</text></view>
    <view class="mrow" wx:for="{{members}}" wx:key="openid">
      <text>{{item.nickname}}{{item.isSelf?'（我）':''}}</text>
      <text class="tag {{item.role==='viewer'?'gray':''}}">{{item.roleText}}</text>
      <text wx:if="{{canManage && item.role!=='owner'}}" class="mini" data-m="{{item}}" bindtap="manageMember">管理</text>
      <text wx:elif="{{canManage}}"></text>
    </view>
  </view>

  <!-- 待接受邀请 -->
  <view wx:if="{{canManage && invites.length}}" class="card">
    <view class="card-title">有效邀请码</view>
    <view class="mrow" wx:for="{{invites}}" wx:key="code">
      <text class="code-t">{{item.code}}</text>
      <text class="muted small">{{item.roleText}} · {{item.days}}天 · 已用{{item.used}}</text>
      <text class="mini danger" data-code="{{item.code}}" bindtap="revokeInvite">撤销</text>
    </view>
  </view>

  <!-- 只读分享 -->
  <view class="card">
    <view class="row-between">
      <view class="card-title" style="margin:0">只读分享（给医生/长辈）</view>
      <text class="link" bindtap="genShare">+ 生成口令</text>
    </view>
    <view wx:if="{{!shares.length}}" class="empty">还没有只读分享</view>
    <view class="mrow" wx:for="{{shares}}" wx:key="token">
      <text class="code-t">{{item.token}}</text>
      <text class="muted small">{{item.days}}天有效</text>
      <text class="mini danger" data-token="{{item.token}}" bindtap="revokeShare">撤销</text>
    </view>
    <view class="muted small mt8">只读分享无法被查看者编辑；可随时撤销。</view>
  </view>

  <view class="card">
    <view class="menu-row" bindtap="acceptInvite"><text>我有邀请码，加入他人宝宝</text><text class="muted">›</text></view>
  </view>
</view>
