.note-area { width: 100%; min-height: 120rpx; font-size: 28rpx; }
.reuse { margin-left: 20rpx; color: var(--primary); font-size: 26rpx; white-space: nowrap; }
.checkbox { width: 36rpx; height: 36rpx; border: 2rpx solid var(--line); border-radius: 8rpx; margin-right: 12rpx; position: relative; }
.checkbox.on { background: var(--primary); border-color: var(--primary); }
.checkbox.on::after { content: "✓"; color: #fff; position: absolute; left: 6rpx; top: -2rpx; font-size: 26rpx; }
.unit-switch { width: 96rpx; text-align: center; padding: 8rpx 0; border: 1rpx solid var(--line); border-radius: 12rpx; color: var(--primary); background: var(--primary-light); }
