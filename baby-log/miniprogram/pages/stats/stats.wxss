.tabs { display: flex; background: #fff; border-radius: 16rpx; padding: 8rpx; margin-bottom: 24rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx; color: var(--text-sub); font-size: 28rpx; }
.tab.on { background: var(--primary); color: #fff; }
.ranges text { font-size: 24rpx; color: var(--text-sub); margin-left: 16rpx; }
.ranges text.on { color: var(--primary); font-weight: 600; }
.sub-num { font-size: 36rpx; font-weight: 700; }

.bars { display: flex; align-items: flex-end; height: 200rpx; overflow-x: auto; margin-top: 24rpx; padding-top: 24rpx; }
.barwrap { width: 52rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.bar { width: 28rpx; background: var(--primary); border-radius: 6rpx 6rpx 0 0; position: relative; min-height: 4rpx; }
.bartip { position: absolute; top: -28rpx; left: 50%; transform: translateX(-50%); font-size: 18rpx; color: var(--text-sub); white-space: nowrap; }
.barx { font-size: 18rpx; color: var(--text-sub); margin-top: 8rpx; white-space: nowrap; }

.mrow { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); font-size: 26rpx; }
.mrow text { flex: 1; }
.mrow.head { color: var(--text-sub); font-size: 24rpx; }

.srow { display: flex; align-items: center; padding: 14rpx 0; }
.sdate { width: 180rpx; font-size: 24rpx; color: var(--text-sub); }
.sbar { height: 20rpx; background: var(--primary-light); border-radius: 10rpx; margin: 0 16rpx; }
.sval { font-size: 26rpx; }
.chartbox { margin-top: 12rpx; }
.bar-info { font-size: 26rpx; color: var(--primary); min-height: 40rpx; padding: 8rpx 0; }
.bar.on { background: #1E8C80; }

/* 记录统计 */
.grid3 { display: flex; margin: 16rpx -8rpx 0; }
.grid3 > .cell { width: 33.33%; padding: 0 8rpx; box-sizing: border-box; }
.hero { text-align: center; padding: 20rpx 0 8rpx; }
.hero-num { font-size: 64rpx; font-weight: 700; color: var(--primary); }
.hero-unit { font-size: 26rpx; font-weight: 400; color: var(--text-sub); margin-left: 6rpx; }
.rcount { display: flex; align-items: center; padding: 12rpx 0; }
.rlabel { width: 88rpx; font-size: 26rpx; color: var(--text); flex-shrink: 0; }
.rtrack { flex: 1; height: 20rpx; background: #F1F3F6; border-radius: 10rpx; overflow: hidden; margin: 0 16rpx; }
.rbar { height: 20rpx; border-radius: 10rpx; min-width: 4rpx; }
.rnum { width: 72rpx; text-align: right; font-size: 26rpx; font-weight: 600; }
