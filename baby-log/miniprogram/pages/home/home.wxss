.baby-bar { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 8rpx 20rpx; }
.baby-name { font-size: 40rpx; font-weight: 700; }
.switch { font-size: 26rpx; }
.hero { margin: 16rpx 0 24rpx; }
.hero-num { font-size: 72rpx; font-weight: 800; color: var(--primary); line-height: 1.1; }
.hero-unit { font-size: 28rpx; color: var(--text-sub); margin-left: 8rpx; font-weight: 400; }
.sub-num { font-size: 40rpx; font-weight: 700; color: var(--text); }
.quick { display: flex; flex-wrap: wrap; padding: 16rpx 8rpx; }
.qbtn { width: 33.33%; display: flex; flex-direction: column; align-items: center; padding: 20rpx 0; color: var(--text); font-size: 26rpx; }
.qi { font-size: 48rpx; margin-bottom: 8rpx; }

.empty-img { display: block; width: 220rpx; height: 220rpx; margin: 0 auto 16rpx; }
