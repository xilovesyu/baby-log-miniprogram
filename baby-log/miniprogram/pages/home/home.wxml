<view class="page">
  <view wx:if="{{!cloudReady}}" class="card" style="background:#FDECEA;color:#E5645A">
    未配置云环境 ID，无法读写数据。见 miniprogram/cloud.js 与 README。
  </view>

  <view class="baby-bar" bindtap="goMy">
    <view class="col">
      <text class="baby-name">{{baby.name || '未命名宝宝'}}</text>
      <text class="muted small">{{ageText}}</text>
    </view>
    <text class="switch muted">切换 / 档案 ›</text>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="card-title" style="margin:0">{{dateLabel}}</view>
      <text class="muted small">累计 {{cumulative}}ml</text>
    </view>
    <view class="hero">
      <view class="hero-num">{{summary.totalMilkMl}}<text class="hero-unit">ml</text></view>
      <view class="muted small">今日总奶量</view>
    </view>
    <view class="grid4">
      <view class="cell"><view class="sub-num">{{summary.feedCount}}</view><view class="stat-label">喂奶次数</view></view>
      <view class="cell"><view class="sub-num">{{summary.avgPerFeed}}</view><view class="stat-label">平均单次ml</view></view>
      <view class="cell"><view class="sub-num">{{summary.solidCount}}</view><view class="stat-label">辅食餐</view></view>
      <view class="cell"><view class="sub-num">{{summary.diaperCount}}</view><view class="stat-label">便便次</view></view>
    </view>
    <view class="small muted mt8">睡眠 {{sleepText}}</view>
  </view>

  <view class="card quick">
    <view class="qbtn" bindtap="goRecord" data-type="feeding"><text class="qi">🍼</text><text>记奶量</text></view>
    <view class="qbtn" bindtap="goRecord" data-type="solid"><text class="qi">🥣</text><text>记辅食</text></view>
    <view class="qbtn" bindtap="goRecord" data-type="diaper"><text class="qi">💩</text><text>记便便</text></view>
    <view class="qbtn" bindtap="goRecord" data-type="sleep"><text class="qi">😴</text><text>记睡眠</text></view>
    <view class="qbtn" bindtap="goRecord" data-type="temp"><text class="qi">🌡️</text><text>记体温</text></view>
    <view class="qbtn" bindtap="goRecord" data-type="weight"><text class="qi">⚖️</text><text>记体重</text></view>
  </view>

  <view class="card">
    <view class="card-title">今日时间轴</view>
    <view wx:if="{{!events.length}}" class="empty">
      <image class="empty-img" src="/images/empty/empty-records.png" mode="aspectFit" />
      <text>今天还没有记录，点上面的按钮开始吧</text>
    </view>
    <view wx:else class="timeline">
      <view class="tl-item" wx:for="{{events}}" wx:key="id" data-item="{{item}}" bindtap="editEvent" bindlongpress="delEvent">
        <view class="tl-time">{{item.noTime ? '未记' : item.time}}</view>
        <view class="tl-dot {{item.type}}"><i></i></view>
        <view class="tl-body">
          <view class="tl-main">{{item.main}}</view>
          <view wx:if="{{item.note}}" class="tl-note">备注：{{item.note}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
